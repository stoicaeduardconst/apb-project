  "components": {
    "schemas": {
      "DecisionIn": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key",
            "nullable": true
          },
          "sku": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Sku"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ORDER_CREATED",
              "NO_ACTION",
              "MANUAL_REVIEW"
            ],
            "title": "Outcome"
          },
          "reason_codes": {
            "items": {
              "type": "string",
              "enum": [
                "ITEM_DISCONTINUED",
                "ABOVE_REORDER_POINT",
                "NO_ELIGIBLE_SUPPLIER",
                "PRICE_INCREASE_REVIEW",
                "BUDGET_EXCEEDED",
                "PO_CREATION_FAILED"
              ]
            },
            "type": "array",
            "maxItems": 6,
            "title": "Reason Codes"
          },
          "supplier_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Supplier Id",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 1.0,
            "title": "Quantity",
            "nullable": true
          },
          "unit_price": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "title": "Unit Price",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "enum": [
              "RON",
              "EUR"
            ],
            "title": "Currency",
            "nullable": true
          },
          "total_cost_ron": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "title": "Total Cost Ron",
            "nullable": true
          },
          "po_number": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Po Number",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "outcome"
        ],
        "title": "DecisionIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NotificationIn": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key",
            "nullable": true
          },
          "template": {
            "type": "string",
            "enum": [
              "po_created",
              "replenishment_review",
              "stockout_risk"
            ],
            "title": "Template"
          },
          "recipient_role": {
            "type": "string",
            "enum": [
              "SUPPLIER",
              "PROCUREMENT_MANAGER",
              "WAREHOUSE_MANAGER"
            ],
            "title": "Recipient Role"
          },
          "recipient": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Recipient"
          },
          "po_number": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Po Number",
            "nullable": true
          },
          "sku": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Sku",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "template",
          "recipient_role",
          "recipient"
        ],
        "title": "NotificationIn"
      },
      "POLineIn": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "POLineIn"
      },
      "PurchaseOrderIn": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key",
            "nullable": true
          },
          "supplier_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Supplier Id"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/POLineIn"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "supplier_id",
          "lines"
        ],
        "title": "PurchaseOrderIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Report_ReportItem": {
        "additionalProperties": false,
        "properties": {
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "ORDER_CREATED",
              "NO_ACTION",
              "MANUAL_REVIEW"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "enum": [
                "ITEM_DISCONTINUED",
                "ABOVE_REORDER_POINT",
                "NO_ELIGIBLE_SUPPLIER",
                "PRICE_INCREASE_REVIEW",
                "BUDGET_EXCEEDED",
                "PO_CREATION_FAILED"
              ],
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "po_number": {
            "type": "string",
            "default": null,
